{
  "name": "ovexiq-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "node --experimental-loader ./test/cloudflare-workers-loader.mjs --test ./test/gateway.test.js ./test/media_proxy.test.js",
    "test:runtime": "node --test ./test/durable_object_runtime.test.js",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "check:staging": "wrangler deploy --dry-run --config wrangler.staging.jsonc",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc"
  },
  "devDependencies": {
    "wrangler": "4.120.0"
  }
}
