{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovexiq-ai-gateway",
  "routes": [
    {
      "pattern": "api.ovexiq.com",
      "custom_domain": true
    }
  ],
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENROUTER_MODEL": "mistralai/mistral-small-2603"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BETA_DAILY_QUOTA",
        "class_name": "BetaDailyQuota"
      },
      {
        "name": "BETA_ACCOUNTS",
        "class_name": "BetaAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BetaDailyQuota"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BetaAccount"]
    }
  ]
}
