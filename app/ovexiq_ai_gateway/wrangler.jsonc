{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovexiq-ai-gateway",
  "routes": [
    {
      "pattern": "api.ovexiq.com",
      "custom_domain": true
    }
  ],
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENROUTER_MODEL": "mistralai/mistral-small-2603"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
