{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ovexiq-ai-gateway-runtime-test",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "OVEXIQ_BETA_TOKENS",
      "OVEXIQ_BETA_INVITES",
      "OVEXIQ_SESSION_SIGNING_KEY"
    ]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENROUTER_MODEL": "mistralai/mistral-small-2603"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "runtime-test-text",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "runtime-test-image",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BETA_DAILY_QUOTA",
        "class_name": "BetaDailyQuota"
      },
      {
        "name": "BETA_ACCOUNTS",
        "class_name": "BetaAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BetaDailyQuota"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BetaAccount"]
    }
  ]
}
